---
import Base from '../layouts/Base.astro';
import type { Property } from '../lib/deals';
interface Props { p: Property }
const { p } = Astro.props;
const isDeal = p.kind === 'deal';

const size = p.beds ? `${p.beds} bd${p.baths ? ` / ${p.baths} ba` : ''}` : '';
const facts = isDeal ? [
  ['Asking price', p.askingPrice],
  ['Estimated ARV', p.arv],
  ['Repair estimate', p.repairEst],
  ['Beds / baths', size],
  ['Size', p.sqft],
  ['Property type', p.type],
  ['Strategy', p.strategy],
].filter(([, v]) => v) : [];

const summary = isDeal
  ? [p.type, p.location, `Ask: ${p.askingPrice}`, p.arv && `ARV: ${p.arv}`].filter(Boolean).join(' · ')
  : p.description.slice(0, 180).replace(/\s+\S*$/, '') + '…';
const ogImage = p.photos.length ? new URL(`/og/${p.kind}/${p.slug}.jpg`, 'https://chattquisitions.com').href : undefined;
const paragraphs = p.description.split(/\n\s*\n|\n/).map((s) => s.trim()).filter(Boolean);
const ask = isDeal ? `Hi, I'm interested in ${p.address}.` : `Hi, I read about ${p.address} on your site.`;
const back = isDeal ? { href: '/#deals', label: 'All deals' } : { href: '/#people-before-profit', label: 'All stories' };
---
<Base title={`${p.address}${p.location ? `, ${p.location}` : ''} | ChattQuisitions`} description={summary} image={ogImage}>
  <main class="pp">
    <div class="wrap pp-top">
      <a class="pp-back" href={back.href}><svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M13 8H3M7 4 3 8l4 4" stroke="currentColor" stroke-width="1.4"/></svg>{back.label}</a>
    </div>

    {p.photos.length > 0 && (
      <section class="gallery" aria-label="Photos" data-gallery>
        <div class="gallery-track">
          {p.photos.map((ph, i) => (
            <figure class="gallery-shot">
              <img src={ph.url} alt={`${p.address}, photo ${i + 1} of ${p.photos.length}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" width={ph.width} height={ph.height} />
            </figure>
          ))}
        </div>
        {p.photos.length > 1 && (
          <div class="gallery-ui wrap">
            <span class="gallery-count tnum" aria-live="polite"><b>1</b> / {p.photos.length}</span>
            <div>
              <button type="button" class="gbtn" data-step="-1" aria-label="Previous photo"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.5"/></svg></button>
              <button type="button" class="gbtn" data-step="1" aria-label="Next photo"><svg width="18" height="18" viewBox="0 0 16 16" fill="none"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg></button>
            </div>
          </div>
        )}
      </section>
    )}

    <div class="wrap pp-body">
      <header class="pp-head">
        <p class="pp-meta">
          {p.badge && <span class="status">{p.badge}</span>}
          {p.location && <span>{p.location}</span>}
        </p>
        <h1>{p.address}</h1>
      </header>

      <div class="pp-cols">
        <div class="pp-main">
          {paragraphs.map((t) => <p>{t}</p>)}
          {p.majors.length > 0 && (
            <div class="pp-needs"><h2 class="kicker">Major items</h2><p>{p.majors.join(', ')}</p></div>
          )}
        </div>

        <aside class="pp-side">
          {facts.length > 0 && (
            <dl class="pp-facts tnum">
              {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
            </dl>
          )}
          <div class="pp-actions">
            <a class="btn btn-solid" href={`sms:+14238746736?&body=${encodeURIComponent(ask)}`}>{isDeal ? 'Ask About This Deal' : 'Ask About This Story'}</a>
            <a class="btn btn-ghost" href={`mailto:jacksonfwood25@gmail.com?subject=${encodeURIComponent(p.address)}&body=${encodeURIComponent(ask)}`}>Email</a>
            <button type="button" class="btn btn-ghost" data-share data-title={p.address}>Share</button>
          </div>
          <p class="pp-call">Or call <a href="tel:+14238746736" class="tnum">(423) 874-6736</a></p>
        </aside>
      </div>
    </div>

    <section class="wrap pp-join">
      {isDeal ? (
        <>
          <p>Want deals like this before they're posted?</p>
          <a class="btn btn-ghost" href="/#buyers-list">Join Buyers List</a>
        </>
      ) : (
        <>
          <p>Know a homeowner in a tough spot? We'll listen.</p>
          <a class="btn btn-ghost" href="/#contact">Get in Touch</a>
        </>
      )}
    </section>
  </main>
  <div class="toast" role="status" aria-live="polite"></div>
</Base>

<style>
  .pp { padding-top: 96px; }
  .pp-top { padding-bottom: 20px; }
  .pp-back { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; color: var(--ink-soft); text-decoration: none; }
  .pp-back:hover { color: var(--ink); }

  .gallery { position: relative; }
  .gallery-track { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0 var(--gutter); scroll-padding: 0 var(--gutter); overscroll-behavior-x: contain; }
  .gallery-track::-webkit-scrollbar { display: none; }
  .gallery-shot { flex: 0 0 auto; height: min(68svh, 720px); scroll-snap-align: start; margin: 0; }
  .gallery-shot img { height: 100%; width: auto; max-width: calc(100vw - var(--gutter) * 2); object-fit: cover; border-radius: var(--radius); background: var(--surface-2); }
  .gallery-ui { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; }
  .gallery-count { font-size: 13px; color: var(--ink-faint); letter-spacing: 0.06em; }
  .gallery-count b { color: var(--ink); font-weight: 500; }
  .gbtn { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: transparent; color: var(--ink); cursor: pointer; display: inline-grid; place-items: center; transition: border-color 150ms var(--ease-out); }
  .gbtn:hover { border-color: var(--ink); }
  .gbtn + .gbtn { margin-left: 8px; }

  .pp-body { padding-top: clamp(40px, 6vw, 80px); }
  .pp-meta { display: flex; gap: 8px 16px; flex-wrap: wrap; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }
  .status { color: var(--ink); }
  .pp h1 { font-size: clamp(2.8rem, 7vw, 6rem); margin-top: 14px; letter-spacing: -0.03em; }
  .pp-cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 7vw, 112px); margin-top: clamp(36px, 5vw, 64px); align-items: start; }
  .pp-main p { font-size: 18px; line-height: 1.75; color: rgba(244,243,241,0.82); max-width: var(--measure); }
  .pp-main p + p { margin-top: 1.1em; }
  .pp-needs { margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .pp-needs p { margin-top: 8px; }
  .pp-side { position: sticky; top: 104px; }
  .pp-facts { border-top: 1px solid var(--line-strong); }
  .pp-facts div { display: flex; justify-content: space-between; gap: 24px; padding: 15px 0; border-bottom: 1px solid var(--line); }
  .pp-facts dt { color: var(--ink-soft); font-size: 15px; }
  .pp-facts dd { font-weight: 500; font-size: 16px; text-align: right; }
  .pp-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 28px; }
  .pp-actions .btn-solid { grid-column: 1 / -1; }
  .pp-call { margin-top: 16px; font-size: 14px; color: var(--ink-faint); }
  .pp-join { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: var(--section); padding-top: 40px; padding-bottom: 72px; border-top: 1px solid var(--line); }
  .pp-join p { font-family: var(--font-display); font-size: clamp(22px, 2.4vw, 30px); }

  @media (max-width: 860px) {
    .pp { padding-top: 84px; }
    .gallery-shot { height: auto; width: calc(100vw - var(--gutter) * 2); aspect-ratio: 4 / 3; }
    .gallery-shot img { width: 100%; height: 100%; }
    .pp-cols { grid-template-columns: 1fr; }
    .pp-side { position: static; order: -1; }
    .pp-main p { font-size: 17px; }
  }

  .toast { position: fixed; left: 50%; bottom: 28px; translate: -50% 0; z-index: 99; background: var(--ink); color: var(--canvas); padding: 12px 20px; border-radius: var(--radius); font-size: 14px; font-weight: 500; opacity: 0; transform: translateY(8px); transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out); pointer-events: none; }
  .toast.show { opacity: 1; transform: none; }
</style>

<script>
  const g = document.querySelector<HTMLElement>('[data-gallery]');
  if (g) {
    const track = g.querySelector<HTMLElement>('.gallery-track')!;
    const shots = [...track.children] as HTMLElement[];
    const count = g.querySelector('.gallery-count b');
    const pos = (s: HTMLElement) => s.offsetLeft - shots[0].offsetLeft;
    const current = () => {
      const x = track.scrollLeft;
      if (x >= track.scrollWidth - track.clientWidth - 2) return shots.length - 1;
      let best = 0;
      shots.forEach((s, i) => { if (Math.abs(pos(s) - x) < Math.abs(pos(shots[best]) - x)) best = i; });
      return best;
    };
    track.addEventListener('scroll', () => { if (count) count.textContent = String(current() + 1); }, { passive: true });
    g.querySelectorAll<HTMLButtonElement>('.gbtn').forEach((b) => b.addEventListener('click', () => {
      const i = (current() + Number(b.dataset.step) + shots.length) % shots.length;
      track.scrollTo({ left: pos(shots[i]), behavior: 'smooth' });
    }));
  }

  const toast = document.querySelector<HTMLElement>('.toast');
  document.querySelector<HTMLButtonElement>('[data-share]')?.addEventListener('click', async (e) => {
    const title = (e.currentTarget as HTMLElement).dataset.title;
    const url = location.href.split('#')[0];
    if (navigator.share && matchMedia('(pointer: coarse)').matches) {
      try { await navigator.share({ title, url }); } catch {}
      return;
    }
    try { await navigator.clipboard.writeText(url); } catch {}
    if (toast) { toast.textContent = 'Link copied'; toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 1800); }
  });
</script>
